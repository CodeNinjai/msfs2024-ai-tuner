[
  {
    "id": "msfs-antialiasing", "impact": "veryhigh", "load": "gpu", "area": "MSFS", "match": "video/antialiasing",
    "name": "Anti-Aliasing", "kind": "enum",
    "options": [
      { "value": "TAA", "label": "TAA (nativ)" },
      { "value": "DLSS", "label": "NVIDIA DLSS" },
      { "value": "FSR", "label": "AMD FSR (unbestätigt)" },
      { "value": "FXAA", "label": "FXAA (unbestätigt)" },
      { "value": "OFF", "label": "Aus (unbestätigt)" }
    ],
    "description": "Kantenglättungsverfahren. TAA rendert in voller nativer Auflösung (schärfste Cockpit-Anzeigen, GPU-teuer). DLSS aktiviert die DLSS-Modus-Auswahl und rendert intern niedriger — mit dem aktuellen Transformer-Modell kaum sichtbarer Unterschied.",
    "rangeNote": "Mit „unbestätigt“ markierte Werte wurden noch nicht gegen die Config validiert.",
    "target": { "type": "msfs", "section": "Video", "key": "AntiAliasing" }
  },
  {
    "id": "msfs-dlssmode", "dependsOnMatch": "video/antialiasing", "dependsOnValue": "DLSS", "impact": "veryhigh", "load": "gpu", "area": "MSFS", "match": "video/dlssmode",
    "name": "DLSS-Modus", "kind": "enum",
    "options": [
      { "value": "DLAA", "label": "DLAA (native Auflösung, beste Qualität)" },
      { "value": "QUALITY", "label": "Qualität" },
      { "value": "BALANCED", "label": "Ausgewogen" },
      { "value": "PERFORMANCE", "label": "Leistung" },
      { "value": "ULTRA_PERFORMANCE", "label": "Ultra-Leistung (unbestätigt)" },
      { "value": "AUTO", "label": "Automatisch" }
    ],
    "description": "Greift nur, wenn Anti-Aliasing auf DLSS steht. Verwaschene Glass-Cockpit-Anzeigen waren ein Problem der alten CNN-Modelle — mit DLSS-4-Transformer-Presets (Treiber-Override aktiv) deutlich verbessert. Per Benchmark gegen TAA vergleichen.",
    "target": { "type": "msfs", "section": "Video", "key": "DLSSMode" }
  },
  {
    "id": "msfs-framegeneration", "impact": "high", "load": "gpu", "area": "MSFS", "match": "video/framegeneration",
    "name": "Frame-Generierung", "kind": "enum",
    "options": [
      { "value": "NONE", "label": "Aus" },
      { "value": "DLSSG", "label": "NVIDIA DLSS Frame Generation" }
    ],
    "description": "Erzeugt Zwischenbilder per KI (RTX 40+). Erhöht die flüssige Darstellung, nicht die Latenz-FPS — Basis-FPS sollte ≥ 30–40 liegen. Benötigt HAGS.",
    "target": { "type": "msfs", "section": "Video", "key": "FrameGeneration" }
  },
  {
    "id": "msfs-nbframes", "dependsOnMatch": "video/framegeneration", "dependsOnValue": "DLSSG", "impact": "medium", "load": "gpu", "area": "MSFS", "match": "video/nbframestogenerate",
    "name": "Framerate-Multiplikator (erzeugte Bilder)", "kind": "number", "min": 1, "max": 3,
    "description": "Anzahl KI-generierter Zwischenbilder pro echtem Frame (1 = 2X). Mehr als 1 nur mit Multi-Frame-Generation (RTX 50).",
    "target": { "type": "msfs", "section": "Video", "key": "NBFramesToGenerate" }
  },
  {
    "id": "msfs-vsync", "area": "MSFS", "match": "video/vsync",
