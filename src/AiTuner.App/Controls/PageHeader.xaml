<UserControl
    x:Class="AiTuner.App.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal">
        <Border Width="44" Height="44" CornerRadius="12" VerticalAlignment="Center"
                Background="{Binding TileBg, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <Viewbox Width="22" Height="22">
                <Path Style="{StaticResource LucideIcon}"
                      Data="{Binding IconKey, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IconKey}}"
                      Stroke="{Binding TileFg, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </Viewbox>
        </Border>
        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Style="{StaticResource H1}" />
            <TextBlock Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Style="{StaticResource Subtle}" Margin="0,3,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
