<UserControl
    x:Class="AiTuner.App.Views.WindowsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AiTuner.App.Controls">
    <Grid>
    <Border Height="200" VerticalAlignment="Top" IsHitTestVisible="False">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1C00A4EF" Offset="0" />
                <GradientStop Color="#00000000" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
    </Border>
    <Grid Margin="28,12,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Title="Windows — Leistungsrelevante Einstellungen"
                             Subtitle="Energie, Grafik, Gaming und System — katalogisierte Einstellungen sind direkt änderbar (?-Bubble erklärt Details)"
                             IconKey="IconSettings" TileBg="#3300A4EF" TileFg="#FF41C0FF" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,8,8,0">
            <StackPanel Margin="0,0,0,24">

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                        <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconPlane}"
                                              Stroke="{StaticResource BrushAccent}" />
                                    </Viewbox>
                                    <TextBlock Text="Flug-Modus — Hintergrunddienste pausieren" FontSize="13.5"
                                               FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"
                                               Margin="9,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding FlightModeStatus}" FontSize="11"
                                           Foreground="{StaticResource BrushTextTertiary}" Margin="25,3,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding FlightModePauseActive, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding RestoreServicesCommand}">
                                <TextBlock Text="Jetzt wiederherstellen" />
                            </Button>
                            <Button Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                                    Command="{Binding StartFlightModeCommand}"
                                    IsEnabled="{Binding FlightModePauseActive, Converter={StaticResource InvBool}}">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                                        <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconZap}"
                                              Stroke="{StaticResource BrushAccent}" />
                                    </Viewbox>
                                    <TextBlock Text="Flug-Modus starten" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding FlightModeServices}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3" ToolTipService.ShowDuration="30000" ToolTip="{Binding Tooltip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Display}" Foreground="{StaticResource BrushTextPrimary}"
                                                       FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </CheckBox>
                                        <Border Grid.Column="1" CornerRadius="4" Padding="7,1" Margin="8,0,14,0"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#26FFFFFF" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="Background" Value="#336CCB5F" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="10">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource BrushOk}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding SampleBackgroundActivityCommand}" Padding="10,5"
                                    ToolTip="2-Sekunden-Messung: Welche Prozesse verbrauchen gerade wirklich CPU? Ehrlicher als jede Dienste-Liste.">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                                        <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconGauge}"
                                              Stroke="{StaticResource BrushTextSecondary}" />
                                    </Viewbox>
                                    <TextBlock Text="Hintergrund-Aktivität messen" Margin="7,0,0,0" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding BackgroundActivity}" Margin="14,2,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11" FontFamily="Consolas"
                                                   Foreground="{StaticResource BrushTextSecondary}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <TextBlock Text="Nur temporär und nur Whitelist: Startarten werden nie verändert; die Wiederherstellung übernimmt der Admin-Helfer automatisch beim Sim-Ende — selbst wenn diese App vorher beendet wird. Effekt messbar über den A/B-Benchmark."
                                   FontSize="11" Foreground="{StaticResource BrushTextTertiary}" TextWrapping="Wrap"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding WindowsRows}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
    </Grid>
</UserControl>
