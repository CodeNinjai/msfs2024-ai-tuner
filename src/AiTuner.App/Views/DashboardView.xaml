<UserControl
    x:Class="AiTuner.App.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Height="260" VerticalAlignment="Top" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#224CC2FF" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,4,20,8">
            <StackPanel Margin="0,8,8,20">

                <Grid>
                    <StackPanel>
                        <TextBlock Text="Systemübersicht" Style="{StaticResource H1}" />
                        <TextBlock Text="{Binding HeaderSubtitle}" Style="{StaticResource Subtle}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                            Command="{Binding RefreshAnalysisCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconRefresh}"
                                      Stroke="{StaticResource BrushTextPrimary}" />
                            </Viewbox>
                            <TextBlock Text="Neu analysieren" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border CornerRadius="12" Padding="20,16" Margin="0,18,0,0"
                        BorderThickness="1" BorderBrush="#404CC2FF">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2E4CC2FF" Offset="0" />
                            <GradientStop Color="#0C4CC2FF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="14" Background="#3D4CC2FF" VerticalAlignment="Center">
                            <Viewbox Width="26" Height="26">
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconLightbulb}"
                                      Stroke="{StaticResource BrushAccent}" />
                            </Viewbox>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding RecCount}" FontSize="42" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccent}" Margin="18,0,16,0"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Empfehlungen aus der Analyse" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border CornerRadius="4" Padding="8,2" Background="#33FF6B6B">
                                    <TextBlock Text="{Binding RecHighText}" FontSize="11" Foreground="{StaticResource BrushBad}" />
                                </Border>
                                <Border CornerRadius="4" Padding="8,2" Background="#33FFB900" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding RecMediumText}" FontSize="11" Foreground="{StaticResource BrushWarn}" />
                                </Border>
                                <Border CornerRadius="4" Padding="8,2" Background="#334CC2FF" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding RecInfoText}" FontSize="11" Foreground="{StaticResource BrushAccent}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="3" Content="Ansehen →" VerticalAlignment="Center" MinWidth="110"
                                Click="GoToRecommendations_Click" />
                    </Grid>
                </Border>

                <TextBlock Text="SYSTEM" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTextTertiary}" Margin="4,22,0,8" />
                <ItemsControl ItemsSource="{Binding HardwareCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Width="340" MinHeight="112" Margin="0,0,12,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="10"
                                            Background="{Binding TileBg}" VerticalAlignment="Top">
                                        <Viewbox Width="20" Height="20">
                                            <Path Style="{StaticResource LucideIcon}"
                                                  Data="{Binding IconKey, Converter={StaticResource IconKey}}"
                                                  Stroke="{Binding TileFg}" />
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="13,0,0,0">
                                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextTertiary}" />
                                        <TextBlock Text="{Binding Value}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextPrimary}"
                                                   TextWrapping="Wrap" Margin="0,5,0,4" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Subtle}" FontSize="11" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="SIMULATOR &amp; WARTUNG" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTextTertiary}" Margin="4,10,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,6,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconPlane}"
                                          Stroke="{StaticResource BrushAccent}" />
                                </Viewbox>
                                <TextBlock Text="MSFS 2024 Installationen" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}" Margin="8,0,0,0" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding InstallationStatus}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,4" ToolTip="{Binding Detail}">
                                            <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource BrushBad}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Ok}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource BrushOk}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Title}" Margin="10,0,0,0" Width="120"
                                                       Foreground="{StaticResource BrushTextPrimary}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Subtle}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconDatabase}"
                                          Stroke="{StaticResource BrushAccent}" />
                                </Viewbox>
                                <TextBlock Text="Caches" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}" Margin="8,0,0,0" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding CacheRows}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BrushRowBorder}" BorderThickness="0,0,0,1" Padding="2,6">
                                            <Grid ToolTip="{Binding Path}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12"
                                                           Foreground="{StaticResource BrushTextPrimary}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding SizeText}" VerticalAlignment="Center"
                                                           Margin="12,0" FontFamily="Consolas" FontSize="12"
                                                           Foreground="{StaticResource BrushTextSecondary}" />
                                                <Button Grid.Column="2" Content="Leeren" FontSize="11" Padding="8,2"
                                                        Visibility="{Binding CanClear, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.ClearCacheCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12"
                        Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconAlert}"
                                      Stroke="{StaticResource BrushWarn}" />
                            </Viewbox>
                            <TextBlock Text="Hinweise" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushWarn}" Margin="8,0,0,0" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Subtle}" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
