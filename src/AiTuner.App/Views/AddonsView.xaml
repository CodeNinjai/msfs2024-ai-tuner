<UserControl
    x:Class="AiTuner.App.Views.AddonsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:AiTuner.App.Controls">
    <Grid>
    <Border Height="200" VerticalAlignment="Top" IsHitTestVisible="False">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1AFFB900" Offset="0" />
                <GradientStop Color="#00000000" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
    </Border>
    <Grid Margin="28,12,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Title="Add-ons &amp; Community-Pakete" Subtitle="{Binding AddonSummary}"
                             IconKey="IconPackage" TileBg="#33FFB900" TileFg="#FFFFB900" />

        <Grid Grid.Row="1" Margin="0,16,8,4">
            <ui:TextBox HorizontalAlignment="Right" Width="280" PlaceholderText="Add-ons filtern …"
                        Text="{Binding AddonFilter, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel Margin="0,0,0,24">

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconRocket}"
                                      Stroke="{StaticResource BrushAccent}" />
                            </Viewbox>
                            <TextBlock Text="Autostart beim Sim-Start (EXE.xml)" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="9,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding AutostartSummary}" FontSize="11"
                                   Foreground="{StaticResource BrushTextTertiary}" Margin="25,3,0,6"
                                   TextWrapping="Wrap" />

                        <ItemsControl ItemsSource="{Binding AutostartRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BrushRowBorder}" BorderThickness="0,0,0,1" Padding="2,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextPrimary}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Meta}" FontSize="11"
                                                           Foreground="{StaticResource BrushTextTertiary}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Meta}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" CornerRadius="4" Padding="8,2" Margin="12,0"
                                                    VerticalAlignment="Center" ToolTip="{Binding StateTooltip}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#26FFFFFF" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Background" Value="#336CCB5F" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsBrokenActive}" Value="True">
                                                                <Setter Property="Background" Value="#33E5B547" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StateLabel}" FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushOk}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsBrokenActive}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushWarn}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Padding="8,5" ToolTip="Im Explorer anzeigen"
                                                        Command="{Binding DataContext.OpenAutostartFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Viewbox Width="13" Height="13">
                                                        <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconFolderOpen}"
                                                              Stroke="{StaticResource BrushTextSecondary}" />
                                                    </Viewbox>
                                                </Button>
                                                <Button Content="{Binding ToggleLabel}" Padding="10,5" Margin="6,0,0,0" FontSize="12"
                                                        ToolTip="Setzt nur das Disabled-Flag in der EXE.xml — der Eintrag bleibt erhalten, Backup wird automatisch angelegt. Wirkt ab dem nächsten Sim-Start."
                                                        Command="{Binding DataContext.ToggleAutostartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconDatabase}"
                                          Stroke="{StaticResource BrushAccent}" />
                                </Viewbox>
                                <TextBlock Text="Content.xml — Paket-Aktivierung des Sims" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}" Margin="9,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <ui:TextBox Grid.Column="1" Width="260" PlaceholderText="Alle Pakete durchsuchen (Name, ICAO) …"
                                        Text="{Binding ContentFilter, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <TextBlock Text="{Binding ContentSummary}" FontSize="11"
                                   Foreground="{StaticResource BrushTextTertiary}" Margin="25,4,0,6"
                                   TextWrapping="Wrap" />

                        <ItemsControl ItemsSource="{Binding ContentRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BrushRowBorder}" BorderThickness="0,0,0,1" Padding="2,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextPrimary}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1" CornerRadius="4" Padding="7,1" Margin="10,0,0,0"
                                                    VerticalAlignment="Center" Background="#26FFFFFF">
                                                <TextBlock Text="{Binding SourceLabel}" FontSize="10"
                                                           Foreground="{StaticResource BrushTextTertiary}" />
                                            </Border>
                                            <Border Grid.Column="2" CornerRadius="4" Padding="8,2" Margin="10,0"
                                                    VerticalAlignment="Center" ToolTip="{Binding StateTooltip}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#26FFFFFF" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Background" Value="#336CCB5F" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSystemDisabled}" Value="True">
                                                                <Setter Property="Background" Value="#33E5B547" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StateLabel}" FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushOk}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSystemDisabled}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushWarn}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <Button Grid.Column="3" Content="{Binding ToggleLabel}" Padding="10,4" FontSize="12"
                                                    Visibility="{Binding CanToggle, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Schaltet den Content-Manager-Zustand (Activated ↔ UserDisabled). Backup automatisch; wirkt beim nächsten Sim-Start. Sim muss geschlossen sein."
                                                    Command="{Binding DataContext.ToggleContentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding AddonRows}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
    </Grid>
</UserControl>
