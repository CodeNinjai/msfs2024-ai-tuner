<UserControl
    x:Class="AiTuner.App.Views.LibrariesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:AiTuner.App.ViewModels"
    xmlns:controls="clr-namespace:AiTuner.App.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    AllowDrop="True" Drop="Root_Drop" DragOver="Root_DragOver" DragLeave="Root_DragLeave">
    <Grid>
    <Border Height="200" VerticalAlignment="Top" IsHitTestVisible="False">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1A2DD4BF" Offset="0" />
                <GradientStop Color="#00000000" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
    </Border>
    <Grid Margin="28,12,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Title="Szenerien — Verwaltung, Bibliotheken &amp; Installation" Subtitle="{Binding LibrarySummary}"
                             IconKey="IconLayers" TileBg="#332DD4BF" TileFg="#FF2DD4BF" />

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,16,8,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Click="InstallMenu_Click" ToolTip="Add-on aus ZIP/7z/RAR oder Ordner installieren — oder einfach hierher ziehen">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconPackage}"
                                          Stroke="{StaticResource BrushAccent}" />
                                </Viewbox>
                                <TextBlock Text="Add-on installieren" Margin="8,0,0,0" />
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Aus Archiv (ZIP, 7z, RAR) …"
                                              Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=InstallFromArchiveCommand}" />
                                    <MenuItem Header="Aus Ordner …"
                                              Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=InstallFromFolderCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Margin="8,0,0,0" Command="{Binding AddLibraryCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconFolderPlus}"
                                          Stroke="{StaticResource BrushTextPrimary}" />
                                </Viewbox>
                                <TextBlock Text="Bibliothek hinzufügen" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Margin="8,0,0,0" Command="{Binding CheckLayoutsCommand}"
                                ToolTip="Gleicht jede layout.json mit dem Ordnerinhalt ab. Findet Dateien, die der Sim IGNORIERT (z.B. manuell installierte Liveries) und repariert sie auf Wunsch — Hersteller-Konfiguratoren (.off, iniBuilds) werden erkannt und in Ruhe gelassen.">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconCheck}"
                                          Stroke="{StaticResource BrushTextPrimary}" />
                                </Viewbox>
                                <TextBlock Text="Layout-Check" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <ui:TextBox Grid.Column="2" Width="250" Margin="12,0" VerticalAlignment="Center"
                                PlaceholderText="Suchen — Name, Ordner oder ICAO …"
                                Icon="{ui:SymbolIcon Search24}"
                                Text="{Binding LibraryFilter, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="3" Text="Neue Add-ons per Drag &amp; Drop hierher ziehen"
                               VerticalAlignment="Center" Style="{StaticResource Subtle}" FontSize="11" />
                </Grid>
                <ItemsControl ItemsSource="{Binding LibraryList}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Background="{StaticResource BrushCardHover}"
                                    Padding="10,8" Margin="0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#332DD4BF"
                                            VerticalAlignment="Center">
                                        <Viewbox Width="16" Height="16">
                                            <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconLayers}"
                                                  Stroke="#FF2DD4BF" />
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushTextPrimary}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Background="{StaticResource BrushAccentSoft}"
                                                    Visibility="{Binding AutoDetected, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="erkannt" FontSize="10"
                                                           Foreground="{StaticResource BrushAccent}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding SubText}" FontSize="11"
                                                   Foreground="{StaticResource BrushTextTertiary}" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Padding="7,5" ToolTip="Im Explorer öffnen"
                                            Command="{Binding DataContext.OpenLibraryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Viewbox Width="14" Height="14">
                                            <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconFolderOpen}"
                                                  Stroke="{StaticResource BrushTextSecondary}" />
                                        </Viewbox>
                                    </Button>
                                    <Button Grid.Column="3" Content="⋯" FontSize="14" Padding="9,2" Margin="6,0,0,0"
                                            ToolTip="Weitere Aktionen" Tag="{Binding}" Click="LibraryMenu_Click">
                                        <Button.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="Umbenennen …" IsEnabled="{Binding CanRestructure}"
                                                          Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=RenameLibraryCommand}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="Migrieren (in anderen Ordner umziehen) …" IsEnabled="{Binding CanRestructure}"
                                                          Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=MigrateLibraryCommand}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="Auflösen — alles zurück in den Community-Ordner" IsEnabled="{Binding CanRestructure}"
                                                          Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=DissolveLibraryCommand}"
                                                          CommandParameter="{Binding}" />
                                                <Separator />
                                                <MenuItem Header="Aus Liste entfernen (Inhalt bleibt unangetastet)"
                                                          IsEnabled="{Binding CanRemove}"
                                                          Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=RemoveLibraryCommand}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Aktivieren/Deaktivieren nutzt NTFS-Junctions im Community-Ordner — ohne Adminrechte, der Inhalt bleibt immer in der Bibliothek. Änderungen wirken beim nächsten Sim-Start."
                           FontSize="11" Foreground="{StaticResource BrushTextTertiary}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <ItemsControl ItemsSource="{Binding LibraryRows}" Margin="0,0,0,24">
                <ItemsControl.Resources>
                    <DataTemplate DataType="{x:Type vm:WarningRow}">
                        <Border BorderBrush="{StaticResource BrushRowBorder}" BorderThickness="0,0,0,1" Padding="2,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="15" Height="15" VerticalAlignment="Top" Margin="0,2,10,0">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconAlert}"
                                          Stroke="{StaticResource BrushWarn}" />
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"
                                           Foreground="{StaticResource BrushTextPrimary}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:LibraryRowItem}">
                        <Border BorderBrush="{StaticResource BrushRowBorder}" BorderThickness="0,0,0,1" Padding="2,6"
                                ToolTip="{Binding Addon.Path}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Display}" Foreground="{StaticResource BrushTextPrimary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Meta}" FontSize="11"
                                               Foreground="{StaticResource BrushTextTertiary}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="4" Padding="7,2" Margin="12,0,0,0" VerticalAlignment="Center"
                                        ToolTipService.ShowDuration="30000" ToolTip="{Binding GsxTooltip}"
                                        Cursor="Hand" Tag="{Binding}" MouseLeftButtonDown="GsxChip_Click"
                                        Visibility="{Binding GsxVisible, Converter={StaticResource BoolToVis}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#26FFFFFF" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GsxHasProfile}" Value="True">
                                                    <Setter Property="Background" Value="#336CCB5F" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="GSX" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GsxHasProfile}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushOk}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Border Grid.Column="2" CornerRadius="4" Padding="8,2" Margin="12,0" VerticalAlignment="Center"
                                        ToolTip="{Binding StateTooltip}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#26FFFFFF" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StateActive}" Value="True">
                                                    <Setter Property="Background" Value="#336CCB5F" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StateLabel}" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StateActive}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushOk}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Padding="8,5" ToolTip="Ordner im Explorer öffnen"
                                            Command="{Binding DataContext.OpenAddonFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Viewbox Width="13" Height="13">
                                            <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconFolderOpen}"
                                                  Stroke="{StaticResource BrushTextSecondary}" />
                                        </Viewbox>
                                    </Button>
                                    <Button Padding="8,5" Margin="6,0,0,0" ToolTip="Aktivieren — Link im Community-Ordner anlegen"
                                            Visibility="{Binding CanActivate, Converter={StaticResource BoolToVis}}"
                                            Tag="{Binding}" Click="ActivateMenu_Click">
                                        <Viewbox Width="13" Height="13">
                                            <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconLink}"
                                                  Stroke="{StaticResource BrushOk}" />
                                        </Viewbox>
                                    </Button>
                                    <Button Padding="8,5" Margin="6,0,0,0"
                                            ToolTip="Deaktivieren — Link entfernen bzw. fest installiertes Add-on in die Bibliothek parken"
                                            Visibility="{Binding CanDeactivate, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.DeactivateLibraryAddonCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Viewbox Width="13" Height="13">
                                            <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconUnlink}"
                                                  Stroke="{StaticResource BrushWarn}" />
                                        </Viewbox>
                                    </Button>
                                    <Button Padding="8,5" Margin="6,0,0,0"
                                            ToolTip="Verschieben — in eine andere Bibliothek oder zurück in den Community-Ordner"
                                            Visibility="{Binding CanMove, Converter={StaticResource BoolToVis}}"
                                            Tag="{Binding}" Click="MoveMenu_Click">
                                        <Viewbox Width="13" Height="13">
                                            <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconMove}"
                                                  Stroke="{StaticResource BrushTextSecondary}" />
                                        </Viewbox>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.Resources>
            </ItemsControl>
        </ScrollViewer>
    </Grid>

    <Border x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False"
            Background="#B01A1D22" CornerRadius="12" Margin="16"
            BorderBrush="{StaticResource BrushAccent}" BorderThickness="2">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Viewbox Width="48" Height="48" HorizontalAlignment="Center">
                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconPackage}"
                      Stroke="{StaticResource BrushAccent}" />
            </Viewbox>
            <TextBlock Text="Zum Installieren hier ablegen" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,14,0,4" HorizontalAlignment="Center" />
            <TextBlock Text="ZIP / 7z / RAR oder Add-on-Ordner — Ziel (Community oder Bibliothek) wählst du danach"
                       FontSize="12" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
    </Grid>
</UserControl>
