<UserControl
    x:Class="AiTuner.App.Views.TuningView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:AiTuner.App.Controls">
    <Grid>
    <Border Height="200" VerticalAlignment="Top" IsHitTestVisible="False">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1CFF8C42" Offset="0" />
                <GradientStop Color="#00000000" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,4,20,8">
        <StackPanel Margin="0,8,8,20">
            <controls:PageHeader Title="Tuning-Assistent"
                                 Subtitle="{Binding TuningStatus}"
                                 IconKey="IconRocket" TileBg="#33FF8C42" TileFg="#FFFF8C42" />

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,12">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Schritt 1 — Checkliste" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                        <Button HorizontalAlignment="Right" Content="Prüfen" FontSize="11" Padding="8,2"
                                Command="{Binding RefreshTuningCheckCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding CheckPresentMon}" Style="{StaticResource Subtle}" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding CheckSim}" Style="{StaticResource Subtle}" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding CheckDynamics}" Style="{StaticResource Subtle}" Margin="0,3,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Messdauer:" VerticalAlignment="Center" Style="{StaticResource Subtle}" />
                        <ComboBox MinWidth="80" Margin="8,0,0,0"
                                  ItemsSource="{Binding Durations}" SelectedItem="{Binding SelectedDuration}" />
                        <TextBlock Text="Sekunden pro Messung" VerticalAlignment="Center"
                                   Style="{StaticResource Subtle}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Schritt 2 — Baseline" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}" />
                    <TextBlock Text="Sichert den aktuellen Stand als Profil und misst die Referenz — im laufenden Sim in der Messsituation."
                               Style="{StaticResource Subtle}" Margin="0,6,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Profil sichern + Baseline messen"
                                IsEnabled="{Binding TuningBusy, Converter={StaticResource InvBool}}"
                                Command="{Binding RunTuningBaselineCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding TuningBaselineText}" FontSize="12"
                               Foreground="{StaticResource BrushAccent}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Schritt 3 — Experiment" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,6"
                                Visibility="{Binding TuningBaselineDone, Converter={StaticResource InvBoolToVis}}">
                        <Border Width="36" Height="36" CornerRadius="10"
                                Background="{StaticResource BrushCardHover}" VerticalAlignment="Center">
                            <Viewbox Width="17" Height="17">
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconLock}"
                                      Stroke="{StaticResource BrushTextTertiary}" />
                            </Viewbox>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Noch gesperrt" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock Text="Dieser Schritt schaltet sich automatisch frei, sobald die Baseline aus Schritt 2 aufgenommen ist."
                                       Style="{StaticResource Subtle}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding TuningBaselineDone, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="EXPERIMENT-PROFIL — DIESER GESPEICHERTE STAND WIRD GETESTET:"
                               FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextTertiary}" Margin="0,12,0,5" />
                    <ComboBox ItemsSource="{Binding ExperimentProfiles}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedExperimentProfile}" />

                    <TextBlock Text="NEUES EXPERIMENT ERZEUGEN:"
                               FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextTertiary}" Margin="0,14,0,5" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding TuningCandidates}" DisplayMemberPath="Title"
                                  SelectedItem="{Binding SelectedCandidate}"
                                  ToolTip="{Binding SelectedCandidate.Reason}" />
                        <Button Grid.Column="1" Content="→ Profil aus Empfehlung" Margin="8,0,0,0"
                                ToolTip="Erzeugt ein Profil „Exp HH-mm …“: aktueller Stand + diese eine Änderung (offline, ohne das System anzufassen) und wählt es oben aus."
                                Command="{Binding CreateExperimentFromCandidateCommand}" />
                        <Button Grid.Column="2" Content="Aktuelle Settings als Profil" Margin="8,0,0,0"
                                ToolTip="Sichert deinen aktuellen Stand (z.B. nach eigenen Editor-Änderungen) als Experiment-Profil und wählt es oben aus."
                                Command="{Binding SaveCurrentAsExperimentCommand}" />
                    </Grid>

                    <Border CornerRadius="8" Background="{StaticResource BrushCardHover}" Padding="12,10" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding TuningStepHint}" FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                            <Button Content="{Binding TuningNextLabel}" MinHeight="36" MinWidth="260"
                                    HorizontalAlignment="Left" FontWeight="SemiBold" Margin="0,10,0,0"
                                    IsEnabled="{Binding TuningNextEnabled}"
                                    Command="{Binding TuningNextCommand}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding TuningMeasureText}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushAccent}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="{Binding TuningMeasured, Converter={StaticResource BoolToVis}}">
                        <Button Command="{Binding KeepCandidateCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconCheck}"
                                          Stroke="{StaticResource BrushOk}" />
                                </Viewbox>
                                <TextBlock Text="Behalten" Margin="7,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Margin="8,0,0,0" Command="{Binding DiscardCandidateCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconX}"
                                          Stroke="{StaticResource BrushBad}" />
                                </Viewbox>
                                <TextBlock Text="Verwerfen — zurück zur Baseline (Sim beenden!)" Margin="7,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Protokoll &amp; Abschluss" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}" />
                    <ItemsControl ItemsSource="{Binding TuningLog}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" FontSize="12"
                                               Foreground="{StaticResource BrushTextPrimary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding DeltaText}" FontFamily="Consolas" FontSize="12"
                                               TextAlignment="Right" Margin="0,0,12,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource BrushOk}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DeltaGood}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushBad}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Text="{Binding DecisionText}" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kept}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushOk}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox PlaceholderText="Name für das Ergebnis-Profil (z.B. „Optimiert 2026-08“)"
                                    Text="{Binding TuningFinalName, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Session abschließen &amp; Profil speichern" Margin="8,0,0,0"
                                Command="{Binding FinishTuningCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>
