<UserControl
    x:Class="AiTuner.App.Views.NvidiaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AiTuner.App.Controls">
    <Grid>
    <Border Height="200" VerticalAlignment="Top" IsHitTestVisible="False">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1A76B900" Offset="0" />
                <GradientStop Color="#00000000" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
    </Border>
    <Grid Margin="28,12,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Title="NVIDIA — Treiberprofile &amp; DLSS" Subtitle="{Binding NvidiaSummary}"
                             IconKey="IconGpu" TileBg="#3376B900" TileFg="#FF9BE32E" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,8,8,0">
            <ItemsControl ItemsSource="{Binding NvidiaRows}" Margin="0,0,0,24" />
        </ScrollViewer>
    </Grid>
    </Grid>
</UserControl>
