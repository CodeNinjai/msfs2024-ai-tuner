<ui:FluentWindow
    x:Class="AiTuner.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="MSFS 2024 AI Tuner"
    Width="1240" Height="800"
    MinWidth="960" MinHeight="600"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="MSFS 2024 AI Tuner" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BrushSidebar}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="v1.0"
                               Style="{StaticResource Subtle}" FontSize="11"
                               Foreground="{StaticResource BrushTextTertiary}"
                               Margin="24,0,12,16" />
                    <StackPanel DockPanel.Dock="Top" Margin="0,10,0,0">
                        <RadioButton Style="{StaticResource NavItemStyle}" IsChecked="True"
                                     Checked="Nav_Checked" Tag="dashboard">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconGauge}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></Viewbox>
                                <TextBlock Text="Übersicht" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavRecommendations" Style="{StaticResource NavItemStyle}" Checked="Nav_Checked" Tag="recommendations">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconLightbulb}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></Viewbox>
                                <TextBlock Text="Empfehlungen" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItemStyle}" Checked="Nav_Checked" Tag="tuning">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconRocket}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></Viewbox>
                                <TextBlock Text="Tuning" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItemStyle}" Checked="Nav_Checked" Tag="msfs">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconPlane}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></Viewbox>
                                <TextBlock Text="MSFS 2024" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItemStyle}" Checked="Nav_Checked" Tag="addons">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconPackage}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></Viewbox>
                                <TextBlock Text="Add-ons" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItemStyle}" Checked="Nav_Checked" Tag="libraries">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconLayers}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></Viewbox>
                                <TextBlock Text="Szenerien" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItemStyle}" Checked="Nav_Checked" Tag="nvidia">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconGpu}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></Viewbox>
                                <TextBlock Text="NVIDIA" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItemStyle}" Checked="Nav_Checked" Tag="windows">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconSettings}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></Viewbox>
                                <TextBlock Text="Windows" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItemStyle}" Checked="Nav_Checked" Tag="profiles">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconSave}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></Viewbox>
                                <TextBlock Text="Profile" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItemStyle}" Checked="Nav_Checked" Tag="benchmark">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconTimer}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></Viewbox>
                                <TextBlock Text="Benchmark" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                    <Grid />
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <ContentControl x:Name="ContentHost" />
                <Grid Background="#99101214"
                      Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True" Width="52" Height="52" />
                        <TextBlock Text="{Binding StatusText}" Margin="0,18,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
