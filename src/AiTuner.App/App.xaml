<Application
    x:Class="AiTuner.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AiTuner.App.ViewModels"
    xmlns:app="clr-namespace:AiTuner.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <app:InverseBooleanConverter x:Key="InvBool" />
            <app:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
            <app:IconKeyConverter x:Key="IconKey" />

            <!-- Lucide-Icon-Grundstil: 24x24-Geometrie, im Viewbox auf Zielgröße skalieren. -->
            <Style x:Key="LucideIcon" TargetType="Path">
                <Setter Property="Stroke" Value="{StaticResource BrushTextSecondary}" />
                <Setter Property="StrokeThickness" Value="2" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="Stretch" Value="None" />
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
            </Style>

            <!-- Eigene Palette: unabhängig von Theme-Token-Namen der UI-Bibliothek -->
            <SolidColorBrush x:Key="BrushCardBackground" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="BrushCardBorder" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="BrushCardHover" Color="#17FFFFFF" />
            <SolidColorBrush x:Key="BrushRowBorder" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="BrushSidebar" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="BrushTextPrimary" Color="#FFF5F7FA" />
            <SolidColorBrush x:Key="BrushTextSecondary" Color="#99EAF0F6" />
            <SolidColorBrush x:Key="BrushTextTertiary" Color="#66DDE4EC" />
            <SolidColorBrush x:Key="BrushAccent" Color="#FF4CC2FF" />
            <SolidColorBrush x:Key="BrushAccentSoft" Color="#334CC2FF" />
            <SolidColorBrush x:Key="BrushOk" Color="#FF6CCB5F" />
            <SolidColorBrush x:Key="BrushWarn" Color="#FFFFB900" />
            <SolidColorBrush x:Key="BrushBad" Color="#FFFF6B6B" />

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BrushCardBackground}" />
                <Setter Property="BorderBrush" Value="{StaticResource BrushCardBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="18,14" />
            </Style>

            <Style x:Key="H1" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            </Style>

            <Style x:Key="Subtle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="NavItemStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Margin" Value="10,2" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Root" CornerRadius="6" Background="Transparent" Padding="14,0">
                                <Grid>
                                    <Rectangle x:Name="Indicator" Width="3" RadiusX="1.5" RadiusY="1.5"
                                               HorizontalAlignment="Left" Margin="-10,11,0,11"
                                               Fill="{StaticResource BrushAccent}" Opacity="0" />
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource BrushCardHover}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource BrushCardBackground}" />
                                    <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Zeilen der Einstellungs-Listen (implizit über DataType) -->
            <DataTemplate DataType="{x:Type vm:GroupHeader}">
                <TextBlock Text="{Binding Title}" Margin="2,20,0,6"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushAccent}" />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:EditableSettingRow}">
                <Border BorderBrush="{StaticResource BrushRowBorder}" BorderThickness="0,0,0,1" Padding="2,6"
                        IsEnabled="{Binding IsRowEnabled}"
                        ToolTipService.ShowOnDisabled="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                    <Setter Property="ToolTip"
                                            Value="Gesperrt — der zugehörige Ein/Aus-Schalter (bzw. die Voraussetzung) ist nicht aktiv." />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Background="Transparent"
                                    ToolTipService.ShowDuration="120000" ToolTipService.InitialShowDelay="250">
                            <StackPanel.ToolTip>
                                <ToolTip MaxWidth="900">
                                <StackPanel MaxWidth="840" Margin="8,6">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{StaticResource BrushAccent}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                               FontSize="13" LineHeight="20" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding MetaText}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushWarn}" Margin="0,8,0,0"
                                               Visibility="{Binding HasMeta, Converter={StaticResource BoolToVis}}" />
                                    <Border Height="1" Background="{StaticResource BrushAccent}" Opacity="0.35"
                                            Margin="0,10,0,8" />
                                    <ItemsControl ItemsSource="{Binding RangeLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <Border CornerRadius="4" Padding="8,1" MinWidth="52"
                                                            Background="{StaticResource BrushAccentSoft}"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding HasValue, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding Value}" FontFamily="Consolas" FontSize="12"
                                                                   Foreground="{StaticResource BrushAccent}"
                                                                   HorizontalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Text}" FontSize="12.5"
                                                               VerticalAlignment="Center" Margin="10,0,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsNote}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource BrushWarn}" />
                                                                        <Setter Property="FontStyle" Value="Italic" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                </ToolTip>
                            </StackPanel.ToolTip>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Width="18" Height="18" CornerRadius="9" Margin="8,0,0,0"
                                    Background="{StaticResource BrushCardHover}" VerticalAlignment="Center">
                                <TextBlock Text="?" FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource BrushTextSecondary}" />
                            </Border>
                            <Border CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                    Background="{StaticResource BrushAccentSoft}"
                                    Visibility="{Binding HasLoad, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding LoadText}" FontSize="10"
                                           Foreground="{StaticResource BrushAccent}" />
                            </Border>
                            <Border CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasImpact, Converter={StaticResource BoolToVis}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#336CCB5F" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ImpactLevel}" Value="medium">
                                                <Setter Property="Background" Value="#33FFB900" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ImpactLevel}" Value="high">
                                                <Setter Property="Background" Value="#40FF8C42" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ImpactLevel}" Value="veryhigh">
                                                <Setter Property="Background" Value="#40FF6B6B" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ImpactText}" FontSize="10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource BrushOk}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ImpactLevel}" Value="medium">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushWarn}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ImpactLevel}" Value="high">
                                                    <Setter Property="Foreground" Value="#FFFF8C42" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ImpactLevel}" Value="veryhigh">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushBad}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                            <ComboBox MinWidth="250" VerticalAlignment="Center"
                                      ItemsSource="{Binding Options}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedOption}">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="enum">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="number">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ui:TextBox Width="110" VerticalAlignment="Center"
                                            Text="{Binding NumberText, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Content="Setzen" Margin="6,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding ApplyNumberCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SettingRow}">
                <Border BorderBrush="{StaticResource BrushRowBorder}" BorderThickness="0,0,0,1" Padding="2,7">
                    <Grid ToolTip="{Binding Detail}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center"
                                   Margin="24,0,0,0" MaxWidth="520" TextAlignment="Right"
                                   FontFamily="Consolas" FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
